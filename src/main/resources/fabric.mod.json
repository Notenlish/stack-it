{
	"schemaVersion": 1,
	"id": "useful-stacks",
	"version": "${version}",
	"name": "Useful Stacks",
	"description": "Increases stack sizes of some items to 64 or 16.",
	"authors": [
		"Notenlish"
	],
	"contact": {
		"sources": "https://github.com/notenlish/stack-it"
	},
	"license": "CC0-1.0",
	"icon": "assets/useful-stacks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.sensiblestacks.SensibleStacks"
		],
		"client": [
			"com.sensiblestacks.client.SensibleStacksClient"
		]
	},
	"mixins": [
		"sensible-stacks.mixins.json",
		{
			"config": "sensible-stacks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}